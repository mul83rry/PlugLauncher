<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0 خالی، بدون پسوند ویندوز: این پروژه جایی است که هر سه سیستم‌عامل کنار هم زندگی
    می‌کنند، پس خودش نباید به هیچ‌کدام گره بخورد. انتخاب پیاده‌سازی در زمان اجرا انجام می‌شود.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>

<Window x:Class="PlugLauncher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlugLauncher Settings"
        Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1B1B"
        FontFamily="Segoe UI">

    <TabControl Style="{StaticResource SegmentedTabControl}"
                Margin="18,16,18,14"
                SelectionChanged="OnTabChanged">

        <!-- ================= Installed plugins ================= -->
        <TabItem Header="Installed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hotkey -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Hotkey"
                               Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Margin="0,0,10,0" />
                    <TextBox x:Name="HotkeyBox"
                             Width="200"
                             Background="#FF2A2A2A"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource SeparatorBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13" />
                    <Button Content="Save"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0"
                            Click="OnSaveHotkey" />
                    <TextBlock x:Name="HotkeyStatus"
                               Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="12" />

                    <CheckBox x:Name="StartWithWindowsBox"
                              Content="Start with Windows"
                              Foreground="{StaticResource TextBrush}"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Margin="24,0,0,0"
                              Checked="OnStartWithWindowsToggled"
                              Unchecked="OnStartWithWindowsToggled" />
                </StackPanel>

                <!-- Tools -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Open plugins folder" Style="{StaticResource GhostButton}" Click="OnOpenPluginsFolder" />
                    <Button Content="Reload" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnReload" />
                    <Button Content="Open log file" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnOpenLog" />
                    <Button Content="Exit PlugLauncher" Style="{StaticResource GhostButton}" Margin="24,0,0,0" Click="OnExitApp" />
                </StackPanel>

                <!-- Updates -->
                <Border Grid.Row="2" Background="#FF232323" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="VersionText"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="13" />
                        <TextBlock x:Name="UpdateStatus"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   FontSize="12.5" />
                        <Button x:Name="UpdateDownloadButton"
                                Content="Open download page"
                                Style="{StaticResource GhostButton}"
                                Margin="12,0,0,0"
                                Visibility="Collapsed"
                                Click="OnOpenUpdatePage" />
                        <Button x:Name="UpdateCheckButton"
                                Content="Check now"
                                Style="{StaticResource GhostButton}"
                                Margin="12,0,0,0"
                                Click="OnCheckForUpdates" />
                        <CheckBox x:Name="AutoUpdateBox"
                                  Content="Check automatically"
                                  Foreground="{StaticResource TextBrush}"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  Margin="18,0,0,0"
                                  Checked="OnAutoUpdateToggled"
                                  Unchecked="OnAutoUpdateToggled" />
                    </StackPanel>
                </Border>

                <!-- Plugin list -->
                <Border Grid.Row="3" Background="#FF232323" CornerRadius="8" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PluginsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,11" Margin="4" CornerRadius="6" Background="#FF2A2A2A">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="15" />
                                                    <TextBlock Text="{Binding Version}"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="12"
                                                               Margin="8,3,0,0" />
                                                    <TextBlock Text="{Binding StateText}"
                                                               Foreground="{Binding StateBrush}"
                                                               FontSize="12"
                                                               Margin="8,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Error}"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           FontSize="11.5"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ErrorVisibility}" />
                                            </StackPanel>

                                            <CheckBox Grid.Column="1"
                                                      Content="Enabled"
                                                      Foreground="{StaticResource TextBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Tag="{Binding Id}"
                                                      Checked="OnPluginToggled"
                                                      Unchecked="OnPluginToggled" />

                                            <Button Grid.Column="2"
                                                    Content="Remove"
                                                    Style="{StaticResource GhostButton}"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding Id}"
                                                    Click="OnUninstall" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="4"
                           x:Name="FooterText"
                           Foreground="{StaticResource HintTextBrush}"
                           FontSize="11.5"
                           Margin="4,10,4,0" />
            </Grid>
        </TabItem>

        <!-- ================= Store ================= -->
        <TabItem Header="Store">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox x:Name="StoreSearchBox"
                             Width="280"
                             Background="#FF2A2A2A"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource SeparatorBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             KeyDown="OnStoreSearchKeyDown" />
                    <Button Content="Search" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnStoreSearch" />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="OnStoreRefresh" />
                    <TextBlock x:Name="StoreStatus"
                               Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12" />
                </StackPanel>

                <!-- Package list -->
                <Border Grid.Row="1" Background="#FF232323" CornerRadius="8" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StoreList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,11" Margin="4" CornerRadius="6" Background="#FF2A2A2A">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding Icon}"
                                                   Width="40" Height="40"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Top"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="15" />
                                                    <TextBlock Text="{Binding VersionText}"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="12"
                                                               Margin="8,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MetaText}"
                                                           Foreground="{StaticResource HintTextBrush}"
                                                           FontSize="11"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="{Binding ActionText}"
                                                    Style="{StaticResource GhostButton}"
                                                    VerticalAlignment="Center"
                                                    MinWidth="90"
                                                    IsEnabled="{Binding CanInstall}"
                                                    Tag="{Binding Id}"
                                                    Click="OnInstallFromStore" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2"
                           x:Name="StoreFooter"
                           Foreground="{StaticResource HintTextBrush}"
                           FontSize="11.5"
                           Margin="4,10,4,0"
                           TextWrapping="Wrap"
                           Text="Downloads are verified against the store's sha256 before anything is installed. The store address lives in settings.json." />
            </Grid>
        </TabItem>
    </TabControl>
</Window>

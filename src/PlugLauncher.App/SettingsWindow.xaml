<Window x:Class="PlugLauncher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات PlugLauncher"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FF1B1B1B"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- هات‌کی -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="هات‌کی:"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Margin="0,0,10,0" />
            <TextBox x:Name="HotkeyBox"
                     Width="200"
                     Background="#FF2A2A2A"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource SeparatorBrush}"
                     Padding="8,6"
                     FontSize="14" />
            <Button Content="ذخیره"
                    Style="{StaticResource GhostButton}"
                    Margin="10,0,0,0"
                    Click="OnSaveHotkey" />
            <TextBlock x:Name="HotkeyStatus"
                       Foreground="{StaticResource SubtleTextBrush}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontSize="12" />
        </StackPanel>

        <!-- ابزارها -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="باز کردن پوشه‌ی پلاگین‌ها" Style="{StaticResource GhostButton}" Click="OnOpenPluginsFolder" />
            <Button Content="بارگذاری مجدد" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnReload" />
            <Button Content="باز کردن فایل لاگ" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenLog" />
        </StackPanel>

        <!-- لیست پلاگین‌ها -->
        <Border Grid.Row="2" Background="#FF232323" CornerRadius="8" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PluginsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="4" CornerRadius="6" Background="#FF2A2A2A">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="15" />
                                            <TextBlock Text="{Binding Version}"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       FontSize="12"
                                                       Margin="8,3,0,0" />
                                            <TextBlock Text="{Binding StateText}"
                                                       Foreground="{Binding StateBrush}"
                                                       FontSize="12"
                                                       Margin="8,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Error}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontSize="11.5"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ErrorVisibility}" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="1"
                                              Content="فعال"
                                              Foreground="{StaticResource TextBrush}"
                                              VerticalAlignment="Center"
                                              Margin="12,0"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Tag="{Binding Id}"
                                              Checked="OnPluginToggled"
                                              Unchecked="OnPluginToggled" />

                                    <Button Grid.Column="2"
                                            Content="حذف"
                                            Style="{StaticResource GhostButton}"
                                            Foreground="{StaticResource DangerBrush}"
                                            VerticalAlignment="Center"
                                            Tag="{Binding Id}"
                                            Click="OnUninstall" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="FooterText"
                   Foreground="{StaticResource SubtleTextBrush}"
                   FontSize="12"
                   Margin="4,10,4,0" />
    </Grid>
</Window>

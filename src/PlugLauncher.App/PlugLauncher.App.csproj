<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PlugLauncher.Core\PlugLauncher.Core.csproj" />
    <ProjectReference Include="..\PlugLauncher.Contracts\PlugLauncher.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- فقط برای آیکن سینی (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PlugLauncher</AssemblyName>
    <RootNamespace>PlugLauncher.App</RootNamespace>
    <ApplicationIcon>assets\pluglauncher.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- WinForms فقط برای NotifyIcon لازم است؛ using سراسری‌اش با WPF تداخل نام دارد -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- آیکن کنار exe هم لازم است: سینی و پنجره‌ی تنظیمات از فایل می‌خوانند -->
  <ItemGroup>
    <Content Include="assets\pluglauncher.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- پلاگین‌های همراه برنامه کنار فایل اجرایی کپی می‌شوند -->
  <ItemGroup>
    <!-- Only these three ship with the app. Everything else in plugins/ goes to the store
         instead, so a fresh install starts with three and the user adds what they want.
         A folder listed here is installed for everyone, whether they asked for it or not. -->
    <None Include="..\..\plugins\calculator\**\*" LinkBase="plugins\calculator" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\password\**\*" LinkBase="plugins\password" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\programs\**\*" LinkBase="plugins\programs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Window x:Class="PlugLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlugLauncher"
        Width="820"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ناحیه‌ی جستجو -->
            <Grid Grid.Row="0" Margin="22,16,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- متن پیشنهادی خاکستری، دقیقاً پشت متن تایپ‌شده -->
                <TextBlock x:Name="HintOverlay"
                           Grid.Column="0"
                           FontSize="30"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis">
                    <Run x:Name="HintTyped" Foreground="Transparent" />
                    <Run x:Name="HintRest" Foreground="{StaticResource HintTextBrush}" />
                </TextBlock>

                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource SearchTextBox}"
                         TextChanged="OnSearchTextChanged"
                         PreviewKeyDown="OnSearchKeyDown" />

                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Content="تنظیمات"
                        VerticalAlignment="Center"
                        Click="OnSettingsClick" />
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{StaticResource SeparatorBrush}"
                    Margin="14,0" />

            <!-- لیست نتایج -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="0,8,0,10"
                     MaxHeight="430"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnResultDoubleClick"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="42" Height="42"
                                    Margin="0,0,16,0"
                                    CornerRadius="6">
                                <Image Source="{Binding Icon}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="19"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12.5"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding SubtitleVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
